# Environment variables for Debs Booking Backend
DATABASE_URL="file:../data/debs.db"
JWT_SECRET="change-this-to-a-long-random-secret"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Twilio WhatsApp credentials
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
# For sandbox: whatsapp:+14155238886
# For production: your registered WhatsApp number in E.164 format e.g. +27821234567
TWILIO_FROM="+14155238886"
